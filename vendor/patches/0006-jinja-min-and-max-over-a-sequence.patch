+/* jinja2's min()/max() over a sequence: the smallest (largest) ITEM, compared by `attribute`
+ * where one is given, and undefined for an empty sequence. `case_sensitive` is accepted and
+ * ignored, exactly as `sort` above it does. */
+template<value_compare_op op>
+static value minmax_fn(const func_args & args) {
+    args.ensure_count(1, 3);
+    if (!is_val<value_array>(args.get_pos(0))) {
+        throw raised_exception("min/max: first argument must be an array");
+    }
+    value val       = args.get_pos(0);
+    value attribute = args.get_kwarg_or_pos("attribute", 2);
+    const bool attr_is_int = is_val<value_int>(attribute);
+    const int64_t attr_int = attr_is_int ? attribute->as_int() : 0;
+    const std::vector<value> arr = val->as_array();   // copy, as sort does
+    if (arr.empty()) {
+        return mk_val<value_undefined>();
+    }
+    auto key = [&](const value & v) -> value {
+        if (attribute->is_undefined()) {
+            return v;
+        }
+        if (attr_is_int && is_val<value_array>(v)) {
+            return v->at(attr_int);
+        }
+        if (!attr_is_int && is_val<value_object>(v)) {
+            return v->at(attribute);
+        }
+        throw raised_exception("min/max: unsupported object attribute comparison on " + v->type());
+    };
+    value best = arr[0];
+    for (size_t i = 1; i < arr.size(); ++i) {
+        if (value_compare(key(arr[i]), key(best), op)) {
+            best = arr[i];
+        }
+    }
+    return best;
+}
