+// RADIANCE: the delimiter around an XML argument value is a NEWLINE, not "whitespace". The
+// template writes <parameter=old_string>\n    return a + b\n</parameter>, and exactly the first
+// and last newline are punctuation -- everything between them, INCLUDING the indentation, is the
+// value the model meant to send. Stripping "one leading whitespace character" eats the first
+// column of every indented hunk, so an agent's exact-match edit never applies and the model that
+// wrote a perfectly good call gets the blame. Strip the delimiter and nothing else.
+static std::string_view strip_one_leading_newline(std::string_view sv) {
+    if (!sv.empty() && sv.front() == '\n') {
+        sv.remove_prefix(1);
+    } else if (sv.size() >= 2 && sv[0] == '\r' && sv[1] == '\n') {
+        sv.remove_prefix(2);
+    }
+    return sv;
+}
+
+static std::string_view strip_one_trailing_newline(std::string_view sv) {
+    if (!sv.empty() && sv.back() == '\n') {
+        sv.remove_suffix(1);
+        if (!sv.empty() && sv.back() == '\r') {
+            sv.remove_suffix(1);
+        }
+    }
+    return sv;
+}
